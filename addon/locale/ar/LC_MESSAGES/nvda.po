#. Translators: Category for Classic Selection in Input Gestures dialog.
#: addon\globalPlugins\classicSelection.py:34 buildVars.py:10
msgid "Classic Selection"
msgstr "التحديد الكلاسيكي"

#: addon\globalPlugins\classicSelection.py:100
msgid ""
"Marks the current position of the review cursor as the start of text to be "
"copied"
msgstr "يعلّم الموضع الحالي لمؤشر المراجعة ليكون بداية النص المراد نسخه"

#. Translators: Presented when there is no text to review or copy.
#: addon\globalPlugins\classicSelection.py:110
#: addon\globalPlugins\classicSelection.py:138
#: addon\globalPlugins\classicSelection.py:152
#: addon\globalPlugins\classicSelection.py:159
msgid "No text to copy"
msgstr "لا يوجد نص لنسخه"

#. Translators: Indicates start of review cursor text to be copied.
#: addon\globalPlugins\classicSelection.py:118
msgid "Start marked"
msgstr "تم تعليم البداية"

#: addon\globalPlugins\classicSelection.py:123
msgid ""
"Retrieves the text from the previously set start marker up to and including "
"the current position of the review cursor and copies it to the clipboard"
msgstr ""
"يجلب النص الواقع بين علامة البداية المحددة سابقاً وموضع مؤشر المراجعة "
"الحالي وينسخه إلى الحافظة"

#. Translators: Presented when attempting copy without start marker.
#: addon\globalPlugins\classicSelection.py:133
msgid "No start marker set"
msgstr "لم تُحدَّد علامة بداية"

#. Translators: Presented when trying to copy across different objects.
#: addon\globalPlugins\classicSelection.py:147
msgid "The start marker must reside within the same object"
msgstr "يجب أن تكون علامة البداية داخل الكائن نفسه"

#. Translators: Presented when review text is copied to clipboard.
#: addon\globalPlugins\classicSelection.py:157
msgid "Review selection copied to clipboard"
msgstr "نُسِخ نص المراجعة المحدد إلى الحافظة"

#: buildVars.py:12
msgid ""
"Restores the classic review cursor selection and copy behaviour of NVDA+f9 "
"and NVDA+f10. Press NVDA+f9 to mark the start, and NVDA+f10 once to directly "
"copy the review selection to the clipboard."
msgstr ""
"تستعيد الإضافة سلوك التحديد والنسخ الكلاسيكي لمؤشر المراجعة عبر NVDA+f9 "
"وNVDA+f10؛ اضغط NVDA+f9 لتعليم البداية، ثم NVDA+f10 مرة واحدة لنسخ نص المراجعة "
"المحدد مباشرة إلى الحافظة."

#: buildVars.py:16
msgid ""
"- Version 2026.1: Modernized for NVDA 2024.1 through 2026.2 with 64-bit "
"support, single-press review cursor copying, bi-directional review "
"selection, and full input gesture integration."
msgstr ""
"- الإصدار 2026.1: تحديث الإضافة للتوافق مع إصدارات NVDA من 2024.1 حتى 2026.2، "
"ودعم معمارية 64 بت، والنسخ بضغطة واحدة من مؤشر المراجعة، ودعم التحديد ثنائي "
"الاتجاه، والتكامل الكامل مع إيماءات الإدخال."
